<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:aplicacionvandex"
             x:Class="aplicacionvandex.AlertasPage" Title="Radar y alertas"
             BackgroundColor="{StaticResource VantexFondo}">
    <CollectionView x:Name="listaAlertas" SelectionMode="None" MaximumWidthRequest="820">
        <CollectionView.Header>
            <VerticalStackLayout Padding="16,20,16,12" Spacing="12">
                <Label Text="Radar y alertas" Style="{StaticResource VantexTitulo}"
                       SemanticProperties.HeadingLevel="Level1"/>
                <!-- El Picker selecciona una regla. El Slider mueve su umbral y el Switch permite pausarla. -->
                <Border Style="{StaticResource VantexTarjeta}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Vigilar portafolio" Style="{StaticResource VantexTextoNormal}" VerticalOptions="Center"/>
                            <!-- El interruptor activa la vigilancia. Los selectores eligen qué comparar y con qué fuente de precios. -->
                            <Switch Grid.Column="1" x:Name="swVigilar" OnColor="{StaticResource VantexVerde}"
                                    SemanticProperties.Description="Vigilar portafolio virtual"/>
                        </Grid>
                        <Label Text="Tipo de alerta" Style="{StaticResource VantexNota}"/>
                        <Picker x:Name="pickerRegla" Style="{StaticResource VantexSelector}" SelectedIndexChanged="OnReglaChanged"
                                SemanticProperties.Description="Tipo de alerta"/>
                        <Label x:Name="lblRegla" Style="{StaticResource VantexNota}"/>
                        <Label Text="Modo de cotización" Style="{StaticResource VantexNota}"/>
                        <Picker x:Name="pickerModo" Style="{StaticResource VantexSelector}" SemanticProperties.Description="Modo de cotización"/>
                        <Label x:Name="lblUmbral" Text="Umbral ±5 %" FontAttributes="Bold" Style="{StaticResource VantexTextoNormal}"/>
                        <!-- El control elige el porcentaje de alerta. ValueChanged actualiza la etiqueta al moverlo. -->
                        <Slider x:Name="sliderUmbral" Minimum="1" Maximum="20" Value="5" ValueChanged="OnUmbralChanged"
                                MinimumTrackColor="{StaticResource VantexVerde}" ThumbColor="{StaticResource VantexVerde}"
                                SemanticProperties.Description="Umbral de uno a veinte por ciento"/>
                        <Button x:Name="btnGuardar" Text="Guardar ajustes" Clicked="OnGuardarClicked" Style="{StaticResource VantexBoton}"/>
                        <Button Text="Probar notificación" Clicked="OnProbarClicked" Style="{StaticResource VantexBotonSecundario}"/>
                    </VerticalStackLayout>
                </Border>
                <Label x:Name="lblEstado" Style="{StaticResource VantexNota}"/>
                <Label Text="Avisos recientes" FontSize="20" FontAttributes="Bold" Style="{StaticResource VantexTextoNormal}"
                       SemanticProperties.HeadingLevel="Level2"/>
                <Button x:Name="btnRevisar" Text="Revisar ahora" Clicked="OnRevisarClicked" Style="{StaticResource VantexBotonSecundario}"/>
                <Label x:Name="lblSinAvisos" Text="Todavía no hay avisos de movimientos." Style="{StaticResource VantexNota}"/>
            </VerticalStackLayout>
        </CollectionView.Header>
        <!-- Cada tarjeta muestra el texto y la fecha de un aviso guardado en el historial. -->
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:AvisoVantex">
                <Border Style="{StaticResource VantexTarjeta}" Margin="16,0,16,8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Titulo}" Style="{StaticResource VantexTextoNormal}" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="{Binding FechaTexto}" Style="{StaticResource VantexNota}"/>
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detalle}" Style="{StaticResource VantexNota}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
